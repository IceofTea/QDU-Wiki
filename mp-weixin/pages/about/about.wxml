<!-- 文件路径: /qdu-wiki/mp-weixin/pages/about/about.wxml -->
<view class="page safe-bottom">
  <view class="card center">
    <view class="logo">📖</view>
    <view class="name">青大百科</view>
    <view class="mut">v1.0.0 · 词条与 QDU-Wiki 网站同步</view>
  </view>

  <view class="card">
    <view class="row-item" bindtap="refresh">
      <text>🔄 刷新词条索引</text>
      <text class="mut">{{refreshText}}</text>
    </view>
    <view class="row-item" bindtap="copySite">
      <text>🌐 打开网页版（复制链接）</text>
      <text class="mut">iceoftea.github.io/QDU-Wiki</text>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">说明</view>
    <view class="mut li">· 词条索引复用网站 search_index.json</view>
    <view class="mut li">· 词条正文经 web-view 加载官网页面，需配置业务域名</view>
    <view class="mut li">· 本应用不收集任何个人信息</view>
  </view>
</view>
