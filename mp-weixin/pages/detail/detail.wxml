<!-- 文件路径: /qdu-wiki/mp-weixin/pages/detail/detail.wxml -->
<!-- 个人主体小程序无 web-view 业务域名权限：详情改本地渲染 search_index.json 正文 -->
<scroll-view scroll-y class="page">
  <view class="title">{{title}}</view>
  <view wx:if="{{loading}}" class="mut center">加载中…</view>
  <view wx:elif="{{empty}}" class="mut center">
    该词条暂无缓存正文
    <view class="btn" bindtap="copy">复制链接去浏览器看原文</view>
  </view>
  <block wx:else>
    <view class="seg" wx:for="{{segs}}" wx:key="index">
      <view wx:if="{{item.h}}" class="seg-h">{{item.h}}</view>
      <text class="seg-t" selectable>{{item.text}}</text>
    </view>
    <view class="src" bindtap="copy">查看官网原文（复制链接）</view>
  </block>
</scroll-view>
