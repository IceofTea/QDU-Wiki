<!-- 文件路径: /qdu-wiki/mp-weixin/pages/detail/detail.wxml -->
<!-- web-view 需在 mp 后台配置业务域名 iceoftea.github.io 并上传校验文件；
     未配置时提示复制链接（见 README） -->
<web-view wx:if="{{url && !showFallback}}" src="{{url}}"></web-view>
<view class="fallback">
  <text class="mut">若页面未加载：需在小程序后台配置业务域名</text>
  <view class="btn" bindtap="copy">复制链接去浏览器打开</view>
</view>
